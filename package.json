{
  "name": "feedback-agence",
  "version": "1.2.0",
  "description": "Feedback Agence",
  "main": "main.js",
  "author": "Agence",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.agence.feedback",
    "productName": "Feedback Agence",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Thajy24",
        "repo": "Feedback-WIndows",
        "releaseType": "release"
      }
    ]
  }
}
